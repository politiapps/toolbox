<?xml version="1.0" encoding="utf-8"?>
<!-- One widget row, laid out to the same rules as the app's .task-row: priority
     owns the left edge (the spine), the due date owns a fixed right-hand column,
     so the two facts triage turns on are separated by *position* before any
     colour is resolved. The due column's fixed width is what makes dates
     comparable down the list. See documentation/ui.md. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/row_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:textColor="#B7B7C0"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.09"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="top">

        <!-- Priority spine. The gutter is reserved on every row whether or not it
             paints, so descriptions stay aligned down the list.
             This is an ImageView rather than a bare <View> deliberately:
             RemoteViews inflates only a fixed whitelist of classes and
             android.view.View is not on it ("Class not allowed to be
             inflated"), which fails the whole row. -->
        <ImageView
            android:id="@+id/row_spine"
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="5dp"
            android:layout_marginRight="5dp"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/row_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="3dp"
            android:src="@drawable/widget_check"
            android:contentDescription="Complete task" />

        <LinearLayout
            android:id="@+id/row_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingLeft="8dp"
            android:orientation="vertical">

            <!-- Title line: description (flexible) + due column (fixed, right). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:id="@+id/row_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#E6E6E8"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/row_due"
                    android:layout_width="66dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/row_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.07"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
